{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "NW-Chrome",
      "request": "launch",
      "type": "dart",
      "flutterMode": "debug",
      "cwd": "example",
      "program": "lib/main.dart",
      "deviceId": "chrome",
      "args": [
        "--web-browser-flag=--disable-web-security"
      ]
    },
    {
      "name": "WASM-Chrome",
      "request": "launch",
      "type": "dart",
      "flutterMode": "profile",
      "cwd": "example",
      "program": "lib/main.dart",
      "deviceId": "chrome",
      "args": [
        "--wasm",
        "--web-browser-flag=--disable-web-security"
      ]
    },
    {
      "name": "Example (macOS Desktop)",
      "request": "launch",
      "type": "dart",
      "flutterMode": "debug",
      "cwd": "example",
      "program": "lib/main.dart",
      "deviceId": "macos"
    }
  ]
}
